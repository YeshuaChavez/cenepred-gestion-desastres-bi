# Credenciales de APIs externas (este archivo .env.example es la plantilla; guardar secretos en Azure Key Vault en producción)
NASA_FIRMS_MAP_KEY=
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
USGS_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1

# Azure OpenAI & Key Vault (Servidor Backend Chatbot)
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=https://cenepred-openai-prod.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Key Vault (fuente única de secretos, leída por common/secrets.py con DefaultAzureCredential).
# Define uno de los dos. Si se omite, el código cae a las variables de entorno de abajo.
KEY_VAULT_URI=https://kv-cenepred-dev1.vault.azure.net
AZURE_KEY_VAULT_NAME=kv-cenepred-dev1

# Gemini (generador de diagnóstico ejecutivo /api/report). Modelo por defecto: gemini-3.6-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ADLS Gen2 — sincronización de la capa Gold (scripts/sync_gold_to_adls.py).
# La key de datos: az storage account keys list --account-name stcenepreddev1 -g rg-cenepred-dev --query "[0].value" -o tsv
AZURE_STORAGE_ACCOUNT=stcenepreddev1
ADLS_GOLD_CONTAINER=gold
AZURE_STORAGE_KEY=

# Alertas por Telegram (ruta app/api/alerts) — ver README para obtener el token y el chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alertas por correo (opcional; sin SMTP_PASS real la ruta solo simula el envío)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
