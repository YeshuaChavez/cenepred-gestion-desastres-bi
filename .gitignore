# ==========================================
# CENEPRED SAT - Enterprise .gitignore
# ==========================================

# ------------------------------------------
# Node.js / React / Vite Webapp
# ------------------------------------------
**/node_modules/
**/dist/
**/build/
**/.next/
**/out/
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ------------------------------------------
# Python & Testing
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------
# Terraform & Infrastructure
# ------------------------------------------
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# ------------------------------------------
# Databricks & Jupyter Notebooks
# ------------------------------------------
.ipynb_checkpoints/

# ------------------------------------------
# Secrets & Environment Variables
# ------------------------------------------
.env
.env.*
*.pem
*.key

# ------------------------------------------
# Data Files (Excluir datasets voluminosos locales)
# ------------------------------------------
**/local_data/

# Artefactos de modelo entrenados sobre datos Gold locales (se regeneran; no se commitean).
data/ml/models/
*.parquet
*.csv
!**/sample_data/*.csv
!**/data/sample/*.csv

# ------------------------------------------
# Power BI & Office Locks
# ------------------------------------------
*.pbix.bak
~$*.docx
~$*.xlsx
~$*.pptx
*.docx

# ------------------------------------------
# OS & IDEs
# ------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
